# ============================================================
#  Unity .gitignore
#  Игнорируем генерируемые редактором папки и файлы.
#  Под версионный контроль идут: Assets/, Packages/, ProjectSettings/
# ============================================================

# Генерируемые Unity папки
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emory[Cc]aptures/

# Папки рекордера/ассетов, генерируемые при импорте
/[Aa]ssets/[Aa]ssetStoreTools*
/[Aa]ssets/[Pp]lugins/[Ee]ditor/JetBrains*

# Multiplayer Play Mode — виртуальные клоны редактора
/[Ll]ibrary/VP/
.mppm

# Кэш Burst
/[Aa]ssets/**/Burst/

# Файлы решений и проектов IDE (генерируются Unity)
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Папки IDE
.vs/
.vscode/
.idea/
.gradle/

# OS-мусор
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Crash-репорты Unity
sysinfo.txt
crashlytics-build.properties

# Builds — собранные исполняемые файлы
*.apk
*.aab
*.unitypackage
*.app

# Не игнорируем meta-файлы (они обязательны для Git!)
!*.meta
